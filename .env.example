# Copy to .env for local use, or add these in Vercel under Settings > Environment Variables.

# The ID from the Google Sheet URL
SHEET_ID=your-google-sheet-id

# The service account key as JSON, on one line
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Required when hosted. Optional locally: leave it out to skip the sign-in page.
DASHBOARD_PASSWORD=choose-a-long-password

# Required when hosted. Create one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a-long-random-value
